{
  "name": "macmaker",
  "version": "1.0.0",
  "description": "<!-- trying to make it sound professional. thar doesnt mean that its all ai --> # MacMaker",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "renderer": "node --check src/renderer/script.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "dist": "electron-builder -wl"
  },
  "build": {
    "appId": "com.pahal.macmaker",
    "productName": "MacMaker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "src/backend/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pahal-desai/MacMaker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pahal-desai/MacMaker/issues"
  },
  "homepage": "https://github.com/pahal-desai/MacMaker#readme",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
